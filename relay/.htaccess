RewriteEngine Off
Options -Indexes

# Pasar el header Authorization a PHP (hosting compartido lo filtra).
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
CGIPassAuth On

# Solo permitir acceso a send.php
<Files "*.php">
    Require all denied
</Files>
<Files "send.php">
    Require all granted
</Files>
<Files "config.php">
    Require all denied
</Files>
