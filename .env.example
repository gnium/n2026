# Variables para docker compose (copiar a .env)
# Clave de API de Anthropic (console.anthropic.com). Si queda vacia, la app arranca en MODO SIMULADO.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MODE=auto
CLAUDE_FALLBACKS=1
DB_ROOT_PASSWORD=root
DB_PASSWORD=notarius
FRONTEND_PORT_HOST=8080
BACKEND_PORT_HOST=3001
DB_PORT_HOST=3307

# ---- Autenticacion ----
# openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-largo
CODIGO_REGISTRO=
REGISTRO_ABIERTO=0
COOKIE_SECURE=0
APP_URL=http://localhost:8080

# ---- IA local (Mac mini): LLM_PROVIDER=local ----
LLM_PROVIDER=auto
# Google Gemini (opcional; tambien se carga desde la app). Clave de aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen3:32b

# ---- Correo para recuperar contrasena (opcional; sin SMTP el enlace sale en el log) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Mercado Pago (suscripciones y fee por uso, ARS) ----
# Access Token de produccion o de prueba, de la seccion "Tus integraciones" en
# https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=
# Secreto de firma de webhooks (misma seccion, "Webhooks" -> "Configurar notificaciones")
MP_WEBHOOK_SECRET=
