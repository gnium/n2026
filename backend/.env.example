# ---- Servidor ----
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# ---- Claude API ----
# Clave de API de Anthropic (https://console.anthropic.com). Nunca la subas a un repositorio.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo por defecto si un skill no define uno en la base de datos
CLAUDE_MODEL=claude-opus-5
# Modo: auto (real si hay clave, simulado si no) | real | mock
CLAUDE_MODE=auto
# Fallback automatico del lado del servidor ante un rechazo de seguridad (1 = activado)
CLAUDE_FALLBACKS=1

# ---- Proveedor de IA ----
# auto: Claude si hay clave, si no simulado | anthropic | local (Ollama / LM Studio) | mock
LLM_PROVIDER=auto
# Google Gemini (opcional; tambien se carga desde la app). Clave de aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:32b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=1200000

# ---- Autenticacion ----
# Secreto para firmar las sesiones (obligatorio en produccion): openssl rand -hex 32
JWT_SECRET=
SESSION_HOURS=12
# 1 en produccion (HTTPS): la cookie de sesion solo viaja cifrada
COOKIE_SECURE=0
# URL publica del frontend (para los enlaces de recuperacion)
APP_URL=http://localhost:5173
# El primer usuario se registra libremente; los siguientes necesitan este codigo (o REGISTRO_ABIERTO=1)
CODIGO_REGISTRO=
REGISTRO_ABIERTO=0
RECUPERACION_MINUTOS=30
# Si el backend esta detras de un proxy (nginx, Railway, tunel): 1
TRUST_PROXY=0

# ---- Correo (recuperacion de contrasena). Si esta vacio, el enlace se imprime en el log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Doy Fe <no-responder@tu-dominio.com>

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=notarius
DB_PASSWORD=notarius
DB_NAME=notarius

# ---- Privacidad / sesiones en memoria ----
# Minutos de inactividad antes de destruir una sesion (y su mapa de datos reales)
SESSION_TTL_MINUTES=30
# Dias hasta que una sesion guardada explicitamente ("Guardar y continuar despues") vence y se borra sola
SESIONES_GUARDADAS_TTL_DIAS=7
# Tamano maximo del archivo en MB
MAX_FILE_MB=15

# ---- Mercado Pago (suscripciones y fee por uso, ARS) ----
# Access Token de produccion o de prueba, de la seccion "Tus integraciones" en
# https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=
# Secreto de firma de webhooks (misma seccion, "Webhooks" -> "Configurar notificaciones")
MP_WEBHOOK_SECRET=
